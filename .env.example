MP2_ENV=development
MP2_DATABASE_URL=postgresql+psycopg://mp2:mp2-dev-only@postgres:5432/mp2
MP2_OBJECT_STORE=seaweedfs
MP2_S3_ENDPOINT=http://seaweedfs:8333
MP2_S3_ACCESS_KEY=mp2-dev
MP2_S3_SECRET_KEY=change-me
MP2_S3_REGION=us-east-1
MP2_TEMPORAL_ADDRESS=temporal:7233
MP2_LOCAL_OBJECT_ROOT=/var/lib/mp2/objects
MP2_INGEST_ROOT=/media
MP2_EXTERNAL_MODELS_ENABLED=false
MP2_LLAMA_BASE_URL=http://llama-server:8080
# Set MP2_LLAMA_MODEL_ID to route local semantic work to llama.cpp instead of the
# deterministic baseline adapter. Must match --alias on the llama-server command.
MP2_LLAMA_MODEL_ID=qwen2.5-1.5b-instruct-q4_k_m
MP2_LLAMA_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
MP2_LLAMA_CONTEXT=8192
MP2_LLAMA_THREADS=4
# Telemetry is OFF unless an OTLP endpoint is set. Uncomment when running the ops
# profile; MP2 emits OTLP only and imports no observability vendor SDK.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
POSTGRES_PASSWORD=mp2-dev-only
GRAFANA_ADMIN_PASSWORD=change-me
